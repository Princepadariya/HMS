# Copy to .env.turso (never commit it) and fill in from the Turso dashboard.
# The same two values go into Vercel → Project → Settings → Environment Variables.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=paste-the-database-token-here

# Optional: hide the one-click staff sign-in list on the login page (recommended once real staff use it)
# HIDE_QUICK_LOGIN=1
